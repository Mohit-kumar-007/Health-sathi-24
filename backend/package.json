{
  "name": "healthsathi24-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "seed": "tsx --env-file=.env scripts/seed-content.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "reset-admin-password": "tsx --env-file-if-exists=.env scripts/reset-admin-password.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  }
}
